controller:
  type: daemonset
  volumes:
    extra:
      - name: nfs-logs
        hostPath:
          path: /mnt/nfs
          type: Directory

alloy:
  mounts:
    extra:
      - name: nfs-logs
        mountPath: /var/log/nfs
        readOnly: true

  configMap:
    content: |
      logging {
        level  = "info"
        format = "logfmt"
      }

      local.file_match "app_logs" {
        path_targets = [
          { "__path__" = "/var/log/nfs/app.log" },
        ]
        sync_period = "5s"
      }

      loki.source.file "app_logs_source" {
        targets    = local.file_match.app_logs.targets
        forward_to = [loki.process.add_labels.receiver]
      }

      loki.process "add_labels" {
        stage.static_labels {
          values = {
            job        = "nginx-test",
            log_source = "nfs",
            env        = "staging",
          }
        }
        forward_to = [loki.write.local_loki.receiver]
      }

      loki.write "local_loki" {
        endpoint {
          url = "http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push"
        }
      }